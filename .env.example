APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-at-least-32-random-characters
JUDGE_RESULT_SECRET=replace-with-an-independent-random-secret
DATABASE_URL=mysql+pymysql://oj:change-me@127.0.0.1:3306/xinbaoyan?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
STORAGE_ROOT=./data
SOURCE_CODE_MAX_BYTES=65536
TEST_DATA_MAX_COMPRESSED_BYTES=52428800
TEST_DATA_MAX_UNCOMPRESSED_BYTES=268435456
TEST_DATA_MAX_FILES=202
# Windows 判题工具链：使用绝对路径，不依赖 Dev-C++ 图形界面。
JUDGE_GCC_PATH=C:/Dev-Cpp/MinGW64/bin/gcc.exe
JUDGE_GPP_PATH=C:/Dev-Cpp/MinGW64/bin/g++.exe
JUDGE_GXX_PATH=C:/Dev-Cpp/MinGW64/bin/g++.exe
JUDGE_JAVAC_PATH=C:/Program Files/Java/jdk1.8.0_202/bin/javac.exe
JUDGE_JAVA_PATH=C:/Program Files/Java/jdk1.8.0_202/bin/java.exe
JUDGE_PYTHON_PATH=C:/Python386/python.exe
JUDGE_USER_PYTHON_PATH=C:/Python386/python.exe
# 本机开发判题模式（不是生产沙箱）
JUDGE_ENV=development
JUDGE_ALLOW_UNSAFE_TESTS=1
